# Server Configuration
PORT=8000
# "development" | "production". In production the server refuses to start
# unless JWT_SECRET is set to a unique string of at least 32 characters.
ENVIRONMENT=development

# Database Configuration (SQLite)
DB_PATH=pantry.db

# JWT Configuration
# REQUIRED in production: unique secret, 32+ characters.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Human-readable expiry used when issuing tokens (e.g. 15m, 24h).
JWT_EXPIRES_IN=24h
# Numeric expiry in seconds actually enforced by the auth service.
JWT_EXPIRES_IN_SECONDS=900
