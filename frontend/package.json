{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "e2e": "npx playwright test",
    "test:perf": "npx playwright test e2e/performance-benchmarks.spec.ts --workers=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:design-system": "node tools/check-design-system.mjs",
    "validate:design-system": "npm run format:check && npm run lint && npm run lint:design-system && npm run test && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@jsverse/transloco": "^8.2.0",
    "@primeng/themes": "^20.3.0",
    "@tailwindcss/postcss": "^4.1.17",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.2",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
